<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <!--
      Test names are sentences: Create_WithMalformedValue_Throws. CA1707 polices
      underscores in identifiers that form a public API surface, which a test project
      does not have. Disabled here rather than per file so the convention stays uniform.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>

    <!--
      xUnit v3 runs on Microsoft.Testing.Platform. The .NET 10 SDK refuses to drive it
      through the old VSTest bridge, so `dotnet test` has to be told to use the new
      runner protocol.
    -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

</Project>
